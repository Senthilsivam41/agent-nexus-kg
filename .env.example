# Copy this file to .env for local development.
# Never commit .env or place real credentials in this example.

# Runtime
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# Default AI gateway for chat/completions
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=

# Add only when the project directly uses these providers.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# Capability-specific models
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
JUDGE_PROVIDER=
JUDGE_MODEL=

# Persistence; keep blank when unused.
DATABASE_URL=
REDIS_URL=

# OpenTelemetry; keep blank or disable in applications that do not emit telemetry.
OTEL_SERVICE_NAME=scale-kg
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_INSECURE=true

# Safe local behavior
OFFLINE_MODE=false
MOCK_MODE=false
ALLOW_LIVE_AI_TESTS=false

